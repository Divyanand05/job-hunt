# ============================================================
# AI Job Hunter — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# --- Gemini API (required) ---
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Himalayas API key (optional) ---
# Raises rate limit to 60 req/min personal allowance.
# Get a free key at: https://himalayas.app/signup/developer
# Leave empty to use the shared public allowance.
HIMALAYAS_API_KEY=

# --- Gmail SMTP (required) ---
# Use a Gmail App Password, NOT your Gmail account password.
# Enable 2FA first, then create App Password:
# https://support.google.com/accounts/answer/185833
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# --- Recipient email (optional, defaults to GMAIL_USER) ---
RECIPIENT_EMAIL=your.email@gmail.com

# --- Tuning (optional, safe defaults shown) ---
MAX_JOB_AGE_HOURS=24
MAX_JOBS_PER_EMAIL=5
GEMINI_MODEL=gemini-1.5-flash

# --- Dry-run mode ---
# Set to true to collect & rank without sending email or writing DB.
DRY_RUN=false
